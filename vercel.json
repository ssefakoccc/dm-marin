{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "all"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/(stok|stok.html)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/kalamis-anadolu-yakasi-marin-servis.html",
      "destination": "/kalamis-fenerbahce-marin-servis.html",
      "permanent": true
    },
    {
      "source": "/atakoy-west-istanbul-marin-servis.html",
      "destination": "/atakoy-west-istanbul-marina-servis.html",
      "permanent": true
    },
    {
      "source": "/tuzla-pendik-marin-servis.html",
      "destination": "/tuzla-pendik-marinturk-marin-servis.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/admin/service-requests/:id",
      "destination": "/api/admin/service-requests?id=:id"
    }
  ]
}